* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Inter', sans-serif;
}

:root {
  color-scheme: dark;
  --bg: #050b16;
  --bg-deep: #0a1220;
  --panel: rgba(15, 23, 42, 0.8);
  --panel-border: rgba(148, 163, 184, 0.18);
  --primary: #8b5cf6;
  --primary-strong: #7c3aed;
  --text: #f8fafc;
  --muted: #94a3b8;
  --accent: #34d399;
  --danger: #ef4444;
}

body {
  margin: 0;
  min-height: 100vh;
  background: linear-gradient(135deg, var(--bg), var(--bg-deep));
  color: var(--text);
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
  border: none;
}

#root {
  min-height: 100vh;
}

.auth-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: radial-gradient(circle at top, rgba(139, 92, 246, 0.2), transparent 30%), linear-gradient(135deg, #020817, #0f172a);
  padding: 24px;
}

.auth-card {
  width: min(100%, 460px);
  background: rgba(15, 23, 42, 0.82);
  border: 1px solid var(--panel-border);
  border-radius: 24px;
  padding: 30px;
  box-shadow: 0 24px 60px rgba(15, 23, 42, 0.45);
}

.brand-row {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
}

.brand-badge {
  width: 28px;
  height: 28px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), #a78bfa);
  color: white;
  font-weight: 800;
}

.brand-name {
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #ddd6fe;
}

.auth-card h1 {
  font-size: clamp(2rem, 3vw, 2.6rem);
  margin-bottom: 8px;
}

.auth-card p {
  color: var(--muted);
  margin-bottom: 22px;
  line-height: 1.6;
}

.auth-card label {
  display: block;
  font-weight: 600;
  margin: 14px 0 8px;
  color: #dbeafe;
}

.auth-card input,
.contact-form input,
.composer input {
  width: 100%;
  padding: 14px 16px;
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(15, 23, 42, 0.7);
  color: var(--text);
  outline: none;
}

.auth-card input:focus,
.contact-form input:focus,
.composer input:focus {
  border-color: rgba(139, 92, 246, 0.8);
  box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.18);
}

button.primary,
button.secondary,
button.ghost,
.contact-form button,
.composer button {
  width: 100%;
  border-radius: 14px;
  padding: 14px 16px;
  color: white;
  font-weight: 700;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

button:hover {
  transform: translateY(-1px);
}

button.primary,
.composer button,
.contact-form button {
  background: linear-gradient(135deg, var(--primary), var(--primary-strong));
}

button.secondary {
  margin-top: 10px;
  background: rgba(148, 163, 184, 0.09);
  border: 1px solid rgba(148, 163, 184, 0.2);
}

.demo-box {
  margin: 12px 0 16px;
  padding: 12px 14px;
  border-radius: 12px;
  background: rgba(139, 92, 246, 0.12);
  border: 1px solid rgba(167, 139, 250, 0.25);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.demo-box span {
  color: #ddd6fe;
  font-size: 12px;
  text-transform: uppercase;
}

.demo-box strong {
  font-size: 2rem;
  letter-spacing: 0.12em;
}

.app-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 26px 18px 30px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.topbar small {
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.topbar h3 {
  margin-top: 6px;
  font-size: 1.5rem;
}

.ghost {
  width: auto;
  padding: 10px 18px;
  background: rgba(148, 163, 184, 0.08);
  color: var(--text);
  border: 1px solid rgba(148, 163, 184, 0.18);
}

.panel {
  background: rgba(15, 23, 42, 0.76);
  border: 1px solid var(--panel-border);
  border-radius: 22px;
  padding: 18px;
  margin-bottom: 18px;
}

.panel-head h2 {
  font-size: 1.2rem;
  margin-bottom: 12px;
}

.contact-form {
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  gap: 12px;
  margin-bottom: 18px;
}

.contact-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
}

.contact-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: 16px;
  background: rgba(148, 163, 184, 0.06);
  border: 1px solid transparent;
  color: var(--text);
  text-align: left;
}

.contact-card.active {
  border-color: rgba(139, 92, 246, 0.7);
  background: rgba(139, 92, 246, 0.11);
}

.contact-card strong,
.chat-user strong {
  display: block;
  margin-bottom: 4px;
}

.contact-card span,
.chat-user small {
  color: var(--muted);
  font-size: 0.72rem;
}

.avatar {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--primary), #a78bfa);
  display: grid;
  place-items: center;
  font-weight: 700;
}

.avatar.large {
  width: 42px;
  height: 42px;
}

.chat-panel {
  min-height: 540px;
  display: flex;
  flex-direction: column;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

.chat-user {
  display: flex;
  align-items: center;
  gap: 12px;
}

.online-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 6px rgba(52, 211, 153, 0.15);
}

.messages {
  flex: 1;
  padding: 18px 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.message-row {
  display: flex;
}

.message-row.mine {
  justify-content: flex-end;
}

.bubble {
  max-width: 75%;
  padding: 12px 14px;
  border-radius: 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.bubble.theirs {
  background: rgba(148, 163, 184, 0.08);
  border-bottom-left-radius: 6px;
}

.bubble.mine {
  background: linear-gradient(135deg, var(--primary), var(--primary-strong));
  border-bottom-right-radius: 6px;
}

.bubble span {
  line-height: 1.5;
}

.bubble small {
  opacity: 0.8;
  font-size: 0.68rem;
}

.composer {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
}

@media (max-width: 720px) {
  .contact-form,
  .composer {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
}
